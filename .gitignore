# ============================================================
# .gitignore — Openvote
# ============================================================
# But : éviter que des secrets, artefacts de build, ou fichiers
# d'environnement locaux finissent dans git.
#
# IMPORTANT : ce fichier est lu par gitleaks via --no-banner.
# Tout fichier sensible NON listé ici reste à risque.
# ============================================================

# ---- Environnements & secrets --------------------------------
.env
.env.*
!.env.example
*.env.local
*.env.production
*.env.staging
*.env.development
*.pem
*.key
*.p12
*.pfx
secrets/
.secrets/

# ---- Tokens d'activation Openvote (cf. audit C2) ------------
# Tout fichier *.txt au top-level qui ressemble à un token est à risque.
# On exclut tout sauf ceux explicitement whitelistés.
*.token
*.tokens
activation_token.txt
openvote-token-*
*-activation-token.*

# ---- Fichiers de mots de passe / credentials ----------------
*credentials*.json
*credentials*.yaml
*credentials*.yml
*.htpasswd
.ghp*
.git-credentials

# ---- Go ------------------------------------------------------
# Binaires
/main
/backend/main
/backend/api
/server
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test artifacts
*.test
*.out
coverage.out
coverage.html
coverage.txt

# Go workspace
go.work
go.work.sum
backend/.cache/

# ---- Node / React / Vite -------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store

# ---- Flutter / Dart ------------------------------------------
**/doc/
**/Pods/
**/.dart_tool/
**/.packages
**/.pub-cache/
**/.pub/
**/build/
**/coverage/
**/pubspec.lock
**/*.iml
**/.idea/
.flutter-plugins
.flutter-plugins-dependencies
**/GeneratedPluginRegistrant.*

# ---- Docker --------------------------------------------------
docker-compose.override.yml
docker-compose.local.yml
.env.docker

# ---- Backups & dumps -----------------------------------------
*.sql.gz
*.dump
*.bak
*.backup

# ---- OS ------------------------------------------------------
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
Icon
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.Trash-*

# ---- Fichiers de secrets générés par les outils --------------
# gitleaks
.gitleaks-report.json
.gitleaks/
# trivy
.trivy/
# tfsec
.tfsec/
